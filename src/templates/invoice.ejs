<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - <%= invoice.invoice_number %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            /* Vibrant & Ultra-Professional Color Palette (Rich Violet, Purple & Indigo Accents) */
            --primary-color: #7c3aed;
            --primary-hover: #6d28d9;
            --primary-gradient: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #4f46e5 100%);
            --primary-glow: 0 4px 14px 0 rgba(124, 58, 237, 0.2);

            --text-main: #111827;
            --text-muted: #6B7280;
            --border-color: #e2e8f0;
            --bg-light: #f8fafc;
            --row-alt-bg: #f6f5fd;

            --dropdown-selected-border: #d8b4fe;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: #fff;
            color: var(--text-main);
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        /* Header Section */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo img {
            max-height: 40px;
            object-fit: contain;
        }
        
        .company-info {
            text-align: right;
            font-size: 11px;
            color: var(--text-muted);
        }
        
        .company-info h1 {
            color: var(--text-main);
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 4px;
        }
        
        .company-info p {
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
        }
        
        .company-info svg {
            width: 12px;
            height: 12px;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* Invoice Title Bar */
        .invoice-title-wrapper {
            display: flex;
            align-items: center;
            margin-bottom: 40px;
            gap: 15px;
        }
        
        .bar-left {
            flex-grow: 1;
            height: 8px;
            background: var(--primary-gradient);
            border-radius: 4px;
        }
        
        .invoice-title {
            font-size: 32px;
            font-weight: 900;
            color: #0F172A;
            letter-spacing: 0.5px;
        }
        
        .bar-right {
            width: 40px;
            height: 8px;
            background: var(--primary-gradient);
            border-radius: 4px;
        }

        /* Middle Section: Bill To & Details */
        .middle-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }

        .bill-to {
            flex: 1;
        }

        .bill-to-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .customer-name {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 16px;
        }

        .customer-contact {
            font-size: 13px;
            color: var(--text-main);
            line-height: 1.6;
        }

        .customer-contact .address-line {
            font-weight: 700;
            color: var(--text-main);
            margin-top: 4px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 8px 0;
        }

        .icon {
            width: 18px;
            height: 18px;
            color: #4F46E5;
            flex-shrink: 0;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .invoice-details-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px 20px;
            width: 260px;
            box-shadow: var(--primary-glow);
        }

        .invoice-details-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--primary-color);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 12px;
        }
        
        .detail-row:last-child {
            margin-bottom: 0;
        }

        .detail-label {
            font-weight: 800;
            color: #111;
        }

        .detail-value {
            color: var(--text-muted);
            font-weight: 600;
            text-align: right;
        }

        /* Table Card Wrapper */
        .table-card {
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(124, 58, 237, 0.08), 0 1px 3px rgba(0,0,0,0.04);
            overflow: hidden;
            margin-bottom: 40px;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        th {
            background: var(--primary-color);
            color: white;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            text-align: left;
        }

        th:first-child { width: 60px; }
        th:last-child { text-align: right; }

        td {
            padding: 18px 20px;
            font-size: 12px;
            vertical-align: middle;
            border-bottom: none;
        }

        tr.odd-row td {
            background: var(--row-alt-bg);
        }

        tr.even-row td {
            background: #FFFFFF;
        }

        td:last-child {
            text-align: right;
            font-weight: 800;
            color: #111;
        }

        .item-name {
            font-weight: 800;
            color: #111;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .item-meta {
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 500;
        }

        .item-meta .dot {
            margin: 0 6px;
            color: #C4B5FD;
        }
        
        td strong {
            font-weight: 800;
            color: #111;
        }

        /* Bottom Section */
        .bottom-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 60px;
        }

        .notes-section {
            width: 40%;
        }

        .thanks-text {
            font-size: 17px;
            font-weight: 800;
            margin-bottom: 28px;
            letter-spacing: 0.2px;
        }

        .terms-title {
            font-size: 15px;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .terms-text {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 2.1;
            font-weight: 500;
        }

        .totals-section {
            width: 280px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 12px;
            font-weight: 800;
        }

        .total-row .value {
            color: var(--text-muted);
            font-weight: 700;
        }

        .total-row.tax-discount {
            font-weight: 700;
        }
        
        .total-row.tax-discount .value {
            color: var(--text-muted);
        }

        .payable-box {
            background: var(--primary-gradient);
            border-radius: 8px;
            padding: 16px 20px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            margin-bottom: 12px;
            box-shadow: var(--primary-glow);
        }

        .payable-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .payable-amount {
            font-size: 22px;
            font-weight: 800;
        }

        .remaining-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 20px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }
        
        .remaining-row .value {
            color: #ef003e;
            font-weight: 800;
        }

        /* Footer */
        .footer {
            border-top: 2px solid var(--primary-color);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 10px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .footer-left {
            display: flex;
            gap: 15px;
        }
        
        .footer-left span {
            position: relative;
        }
        
        .footer-left span:not(:last-child)::after {
            content: "|";
            position: absolute;
            right: -10px;
            color: #CBD5E1;
            font-weight: 400;
        }

        .auth-sign {
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 800;
            color: var(--text-main);
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="header">
        <div class="logo">
            <% if(owner.logo){ %>
                <img src="<%= owner.logo %>" alt="Logo">
            <% } %>
        </div>
        <div class="company-info">
            <h1><%= owner.shop_name %></h1>
            <p>Proprietor: <%= owner.owner_name %></p>
            <p><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> <%= owner.email %></p>
        </div>
    </div>

    <!-- Invoice Title -->
    <div class="invoice-title-wrapper">
        <div class="bar-left"></div>
        <div class="invoice-title">INVOICE</div>
        <div class="bar-right"></div>
    </div>

    <!-- Middle Section -->
    <div class="middle-section">
        <div class="bill-to">
            <div class="bill-to-label">Invoice To:</div>
            <div class="customer-name"><%= invoice.first_name %> <%= invoice.last_name %></div>
            <div class="customer-contact">
                <div class="contact-item"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> <span><%= invoice.phone_number %></span></div>
                <div class="contact-item"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg> <span><%= invoice.email %></span></div>
                <p class="address-line"><%= invoice.address %>, <%= invoice.city %>, <%= invoice.state %></p>
            </div>
        </div>

        <div class="invoice-details-card">
            <div class="invoice-details-label">Invoice Details</div>
            
            <div class="detail-row">
                <span class="detail-label">Invoice#</span>
                <span class="detail-value"><%= invoice.invoice_number %></span>
            </div>
            
            <div class="detail-row">
                <span class="detail-label">Date</span>
                <span class="detail-value"><%= new Date(invoice.created_at).toLocaleDateString('en-GB') %></span>
            </div>
            
            <div class="detail-row">
                <span class="detail-label">Payment</span>
                <span class="detail-value"><%= invoice.payment_status %></span>
            </div>
            
            <div class="detail-row">
                <span class="detail-label">Mode</span>
                <span class="detail-value"><%= invoice.payment_mode %></span>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>SL.</th>
                    <th>Item Description</th>
                    <th>MRP</th>
                    <th>Qty.</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach((item, index) => { %>
                <tr class="<%= index % 2 === 0 ? 'odd-row' : 'even-row' %>">
                    <td><strong><%= index + 1 %></strong></td>
                    <td>
                        <div class="item-name"><%= item.product_name %></div>
                        <div class="item-meta"><% if(item.sku) { %>Code: <%= item.sku %><span class="dot">•</span><% } %>Rate: ₹<%= Number(item.selling_price).toFixed(2) %></div>
                    </td>
                    <td><strong>₹<%= Number(item.selling_price).toFixed(2) %></strong></td>
                    <td><strong><%= item.quantity %></strong></td>
                    <td>₹<%= Number(item.line_total).toFixed(2) %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Bottom Section -->
    <div class="bottom-section">
        <div class="notes-section">
            <div class="thanks-text">Thank you for your business</div>
            
            <div class="terms-title">Terms & Conditions</div>
            <div class="terms-text">
                Goods once sold will not be taken back unless otherwise agreed. 
                Please verify all items at the time of billing. Payment related 
                issues should be referenced with the invoice number.
            </div>
        </div>

        <div class="totals-section">
            <div class="total-row">
                <span>Sub Total:</span>
                <span class="value">₹<%= Number(invoice.subtotal).toFixed(2) %></span>
            </div>

            <div class="total-row">
                <span>Item Discount:</span>
                <span class="value">-₹<%= Number(invoice.discount_total).toFixed(2) %></span>
            </div>
            
            <div class="total-row tax-discount">
                <span>Tax:</span>
                <span class="value">₹<%= Number(invoice.tax_total).toFixed(2) %></span>
            </div>
            
            <div class="total-row">
                <span>Total Billed Amount:</span>
                <span class="value">₹<%= Number(invoice.total_amount).toFixed(2) %></span>
            </div>
            
            <div class="total-row tax-discount">
                <span>Total Discount:</span>
                <span class="value">-₹<%= Number(invoice.discount_total).toFixed(2) %></span>
            </div>
            
            <div class="total-row">
                <span>Paid:</span>
                <span class="value">₹<%= Number(invoice.paid_amount).toFixed(2) %></span>
            </div>

            <div class="payable-box">
                <span class="payable-label">TOTAL PAYABLE</span>
                <span class="payable-amount">₹<%= Number(invoice.total_amount).toFixed(2) %></span>
            </div>

            <div class="remaining-row"><span>Remaining</span>
                <span class="value">₹<%= Number(invoice.remaining_amount).toFixed(2) %></span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <div class="footer-left">
            <span><%= owner.phone %></span>
            <span><%= owner.address %></span>
            <span><%= owner.email %></span>
        </div>
        <div class="auth-sign">
            Authorised Sign
        </div>
    </div>
</body>
</html>
